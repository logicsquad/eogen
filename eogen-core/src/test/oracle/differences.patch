Where eogen's bundled templates deliberately differ from WOLips's, run.sh
applies this patch to WOLips's output in src/test/resources/corpus/expected.

- A to-many relationship to a partial entity takes its inverse key from the
  partial's class, which declares it, rather than the class of the entity
  that the partial extends, which doesn't compile (#18).

diff -ru a/ERXPartialExampleWonder/er/example/erxpartials/model/_Department.java b/ERXPartialExampleWonder/er/example/erxpartials/model/_Department.java
--- a/ERXPartialExampleWonder/er/example/erxpartials/model/_Department.java
+++ b/ERXPartialExampleWonder/er/example/erxpartials/model/_Department.java
@@ -101,7 +101,7 @@
     NSArray<er.example.erxpartials.model.Person> results;
     if (fetch) {
       EOQualifier fullQualifier;
-      EOQualifier inverseQualifier = ERXQ.equals(er.example.erxpartials.model.Person.DEPARTMENT_KEY, this);
+      EOQualifier inverseQualifier = ERXQ.equals(er.example.erxpartials.model.Partial_EmployeePerson.DEPARTMENT_KEY, this);
 
       if (qualifier == null) {
         fullQualifier = inverseQualifier;
diff -ru a/ERXPartialExampleWonder/er/example/erxpartials/model/_EmployeeType.java b/ERXPartialExampleWonder/er/example/erxpartials/model/_EmployeeType.java
--- a/ERXPartialExampleWonder/er/example/erxpartials/model/_EmployeeType.java
+++ b/ERXPartialExampleWonder/er/example/erxpartials/model/_EmployeeType.java
@@ -65,7 +65,7 @@
     NSArray<er.example.erxpartials.model.Person> results;
     if (fetch) {
       EOQualifier fullQualifier;
-      EOQualifier inverseQualifier = ERXQ.equals(er.example.erxpartials.model.Person.EMPLOYEE_TYPE_KEY, this);
+      EOQualifier inverseQualifier = ERXQ.equals(er.example.erxpartials.model.Partial_EmployeePerson.EMPLOYEE_TYPE_KEY, this);
 
       if (qualifier == null) {
         fullQualifier = inverseQualifier;
