<html>
<head>
	<title>${storedProcedure.model.name}, ${storedProcedure.name}</title>
	<link href = "../../eomodeldoc.css" rel = "stylesheet" type = "text/css">
	<script src = "../../prototype.js"></script>
</head>
<body>
<h1>${storedProcedure.model.name}</h1>
<h2>${storedProcedure.name}</h2>
#if ($storedProcedure.documentation)
<div class = "documentation">$storedProcedure.documentation</div>
#end

<h3>Arguments</h3>
<ul>
	#foreach($argument in $storedProcedure.sortedArguments)
	<li>${argument.name}#if ($argument.documentation)<div class = "documentation">$argument.documentation</div>#end</li>
	#end
</ul>

</body>
</html>
